--- /dev/null
+++ b/megatron/core/ssm/xlstm_mixer.py
@@ -0,0 +1,248 @@
+# Copyright (c) 2026 Gipfelsturm. xLSTM mixer for Megatron-LM core_v0.16.1.
+#
+# Install path: megatron/core/ssm/xlstm_mixer.py
+#   (mirrors megatron/core/ssm/mamba_mixer.py)
+#
+# Megatron-compatible drop-in replacement for SelfAttention.
+# Wraps an mLSTM block (matrix-memory LSTM from Beck et al. 2024, "xLSTM:
+# Extended Long Short-Term Memory") so it satisfies the contract expected by
+# TransformerLayer + TransformerLayerSubmodules:
+#   - constructor signature compatible with attention.SelfAttention
+#   - forward(hidden_states, attention_mask, ..., **kwargs) -> (output, bias)
+#   - hidden_states shape is [seq, batch, hidden] (sequence-first)
+#   - bias is returned as None so get_bias_dropout_add handles the residual
+
+from typing import Optional
+
+import torch
+from torch import Tensor, nn
+
+from megatron.core.transformer.module import MegatronModule
+from megatron.core.transformer.transformer_config import TransformerConfig
+
+
+class xLSTMMixerSubmodules:
+    """Placeholder submodules dataclass — currently the mixer is self-contained
+    and does not delegate any submodules out. Kept for API symmetry with
+    SelfAttentionSubmodules so the spec system can pass `submodules=` if we
+    later want to swap the inner mLSTM implementation."""
+
+    def __init__(self):
+        pass
+
+
+class xLSTMMixer(MegatronModule):
+    """xLSTM (mLSTM-variant) sequence mixer.
+
+    Replaces SelfAttention inside a TransformerLayer. The outer TransformerLayer
+    still owns: input_layernorm, residual add, pre_mlp_layernorm, MLP, etc.
+    This module owns only the sequence-mixing operation between the two norms.
+
+    The mLSTM cell maintains a matrix-valued cell state C_t and a scalar
+    normalizer n_t per head; updates are gated by input/forget/output gates
+    derived from the input. Causal by construction — ignores attention_mask.
+
+    Args:
+        config: TransformerConfig from Megatron. Drives hidden_size, kv_channels
+            (used as head_dim), num_attention_heads (used as num_heads), dropout,
+            init scheme, and dtype.
+        submodules: Unused; kept for spec-system compatibility.
+        layer_number: 1-indexed layer position. Used by Megatron for logging
+            and (potentially) per-layer init scaling.
+        attn_mask_type: Ignored — xLSTM is causal by gate construction.
+    """
+
+    def __init__(
+        self,
+        config: TransformerConfig,
+        submodules: Optional[xLSTMMixerSubmodules] = None,
+        layer_number: int = 1,
+        attn_mask_type=None,
+    ):
+        super().__init__(config=config)
+
+        self.config = config
+        self.layer_number = layer_number
+        self.hidden_size = config.hidden_size
+        self.num_heads = config.num_attention_heads
+        assert self.hidden_size % self.num_heads == 0, (
+            f"hidden_size ({self.hidden_size}) must be divisible by "
+            f"num_attention_heads ({self.num_heads})"
+        )
+        self.head_dim = self.hidden_size // self.num_heads
+
+        # --- Input projections ---------------------------------------------
+        # qkv-style projection: produce query, key, value plus three gates
+        # (input, forget, output). The mLSTM uses q/k/v just like attention
+        # does, but the temporal mixing is recurrent rather than softmax.
+        #
+        # We pack everything into one big linear for kernel efficiency:
+        #   projection_out = [q | k | v | i_gate | f_gate | o_gate]
+        # All six are hidden_size wide.
+        self.in_proj = nn.Linear(
+            self.hidden_size, 6 * self.hidden_size, bias=False,
+            dtype=config.params_dtype,
+        )
+
+        # --- Causal depth-wise conv on q,k,v -------------------------------
+        # Short-range smoothing before the recurrence — same trick Mamba uses.
+        # Kernel size 4 is standard; depth-wise so it stays cheap.
+        conv_dim = 3 * self.hidden_size  # over q, k, v
+        self.conv_kernel_size = 4
+        self.conv1d = nn.Conv1d(
+            in_channels=conv_dim,
+            out_channels=conv_dim,
+            kernel_size=self.conv_kernel_size,
+            groups=conv_dim,  # depth-wise
+            padding=self.conv_kernel_size - 1,  # left-pad for causality
+            bias=True,
+            dtype=config.params_dtype,
+        )
+
+        # --- Per-head learned scaling for the recurrent update -------------
+        # mLSTM equation: C_t = f_t * C_{t-1} + i_t * (v_t k_t^T)
+        # n_t = f_t * n_{t-1} + i_t * k_t
+        # Output: h_t = o_t * (C_t q_t) / max(|n_t^T q_t|, 1)
+        # We use a learnable per-head temperature on the gates for stability.
+        self.gate_logit_scale = nn.Parameter(
+            torch.ones(self.num_heads, dtype=config.params_dtype)
+        )
+
+        # --- Output norm + projection --------------------------------------
+        # Group norm over heads (per-head normalization) before output proj.
+        # Acts like the "output norm" in the xLSTM paper.
+        self.out_norm = nn.GroupNorm(
+            num_groups=self.num_heads,
+            num_channels=self.hidden_size,
+            affine=True,
+            dtype=config.params_dtype,
+        )
+        self.out_proj = nn.Linear(
+            self.hidden_size, self.hidden_size, bias=False,
+            dtype=config.params_dtype,
+        )
+
+    # ----------------------------------------------------------------------
+    # Recurrent core
+    # ----------------------------------------------------------------------
+    def _mlstm_recurrent(
+        self, q: Tensor, k: Tensor, v: Tensor,
+        i_gate: Tensor, f_gate: Tensor, o_gate: Tensor,
+    ) -> Tensor:
+        """mLSTM forward pass in matrix-memory form.
+
+        Shapes (all sequence-first):
+            q, k, v : [s, b, num_heads, head_dim]
+            i_gate, f_gate : [s, b, num_heads]  (scalar gates per head)
+            o_gate : [s, b, num_heads, head_dim]  (vector gate per head)
+
+        Returns:
+            output : [s, b, num_heads, head_dim]
+
+        This is the unparallelized reference implementation — fine for
+        throughput benchmarking but slow at long sequences. A fused
+        Triton kernel would be the next step if quality matters; for the
+        gipfelsturm throughput comparison this is sufficient.
+        """
+        s, b, h, d = q.shape
+        device, dtype = q.device, q.dtype
+
+        # Matrix cell state C: [b, h, d, d], scalar normalizer n: [b, h, d]
+        C = torch.zeros(b, h, d, d, device=device, dtype=dtype)
+        n = torch.zeros(b, h, d, device=device, dtype=dtype)
+
+        outputs = []
+        for t in range(s):
+            q_t = q[t]                # [b, h, d]
+            k_t = k[t]                # [b, h, d]
+            v_t = v[t]                # [b, h, d]
+            i_t = i_gate[t].unsqueeze(-1).unsqueeze(-1)  # [b, h, 1, 1]
+            f_t = f_gate[t].unsqueeze(-1).unsqueeze(-1)  # [b, h, 1, 1]
+            o_t = o_gate[t]                              # [b, h, d]
+
+            # Outer product v k^T -> [b, h, d, d]
+            vk = torch.einsum('bhd,bhe->bhde', v_t, k_t)
+
+            # State update
+            C = f_t * C + i_t * vk
+            n = f_gate[t].unsqueeze(-1) * n + i_gate[t].unsqueeze(-1) * k_t
+
+            # Read out: numerator [b, h, d] = C q, denom max(|n^T q|, 1)
+            Cq = torch.einsum('bhde,bhe->bhd', C, q_t)
+            denom = (n * q_t).sum(-1, keepdim=True).abs().clamp(min=1.0)
+            h_t = o_t * (Cq / denom)
+
+            outputs.append(h_t)
+
+        return torch.stack(outputs, dim=0)  # [s, b, h, d]
+
+    # ----------------------------------------------------------------------
+    # forward
+    # ----------------------------------------------------------------------
+    def forward(
+        self,
+        hidden_states: Tensor,
+        attention_mask: Optional[Tensor] = None,
+        key_value_states: Optional[Tensor] = None,
+        inference_context=None,
+        rotary_pos_emb=None,
+        rotary_pos_cos=None,
+        rotary_pos_sin=None,
+        attention_bias=None,
+        packed_seq_params=None,
+        sequence_len_offset=None,
+        rotary_pos_cos_sin=None,
+        **kwargs,
+    ):
+        """Forward pass.
+
+        Args (only the relevant ones — rest are accepted for spec compatibility):
+            hidden_states: [s, b, hidden]
+
+        Returns:
+            (output, bias) where bias is None so get_bias_dropout_add does
+            a plain residual add.
+        """
+        s, b, _ = hidden_states.shape
+
+        # --- Project ------------------------------------------------------
+        proj = self.in_proj(hidden_states)  # [s, b, 6*hidden]
+        q, k, v, i_raw, f_raw, o_raw = proj.chunk(6, dim=-1)
+
+        # --- Causal conv on q,k,v -----------------------------------------
+        # Conv1d expects [b, c, s]; we have [s, b, c]. Transpose, conv, slice
+        # off the right-padding to keep causality, then transpose back.
+        qkv = torch.cat([q, k, v], dim=-1)             # [s, b, 3h]
+        qkv = qkv.permute(1, 2, 0)                     # [b, 3h, s]
+        qkv = self.conv1d(qkv)[..., :s]                # trim causal pad
+        qkv = qkv.permute(2, 0, 1)                     # [s, b, 3h]
+        q, k, v = qkv.chunk(3, dim=-1)
+        q, k, v = (torch.nn.functional.silu(t) for t in (q, k, v))
+
+        # --- Reshape to heads ---------------------------------------------
+        q = q.view(s, b, self.num_heads, self.head_dim)
+        k = k.view(s, b, self.num_heads, self.head_dim)
+        v = v.view(s, b, self.num_heads, self.head_dim)
+
+        # --- Gates --------------------------------------------------------
+        # Input gate: scalar per head (sigmoid)
+        # Forget gate: scalar per head (sigmoid, with learnable scale)
+        # Output gate: vector per head (sigmoid)
+        i_gate = torch.sigmoid(i_raw.view(s, b, self.num_heads, self.head_dim).mean(-1))
+        f_gate = torch.sigmoid(
+            f_raw.view(s, b, self.num_heads, self.head_dim).mean(-1)
+            * self.gate_logit_scale
+        )
+        o_gate = torch.sigmoid(o_raw.view(s, b, self.num_heads, self.head_dim))
+
+        # --- Recurrent core -----------------------------------------------
+        out = self._mlstm_recurrent(q, k, v, i_gate, f_gate, o_gate)
+
+        # --- Merge heads, norm, project -----------------------------------
+        out = out.reshape(s, b, self.hidden_size)
+        # GroupNorm needs [N, C, *] — treat (s*b) as batch
+        out = self.out_norm(out.reshape(s * b, self.hidden_size, 1)).reshape(s, b, self.hidden_size)
+        out = self.out_proj(out)
+
+        # Megatron expects (output, bias) — bias=None means plain residual
+        return out, None
