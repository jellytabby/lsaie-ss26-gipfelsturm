+"""pretrain_xlstm.py — entrypoint for xLSTM throughput runs.
+
+Install path: pretrain_xlstm.py (top-level of Megatron-LM, sibling of pretrain_gpt.py)
+
+Reuses everything from pretrain_gpt.py (data pipeline, loss, training loop,
+argument parsing, distributed setup) and only swaps the layer spec used
+inside model_provider() by monkey-patching get_gpt_decoder_block_spec.
+
+No edits to pretrain_gpt.py or any other Megatron file needed.
+"""
+
+import os
+import runpy
+
+from megatron.core.extensions.transformer_engine import TENorm
+from megatron.core.models.xlstm import xlstm_layer_spec
+from megatron.core.transformer.transformer_block import (
+    TransformerBlockSubmodules,
+    get_num_layers_to_build,
+)
+from megatron.core.transformer.transformer_layer import get_transformer_layer_offset
+
+import megatron.core.models.gpt.gpt_layer_specs as _gpt_specs
+
+
+def _xlstm_block_spec(config, use_transformer_engine, *args, **kwargs):
+    """Drop-in replacement for get_gpt_decoder_block_spec returning an
+    xLSTM-everywhere block. If you want a hybrid (some xLSTM, some attention)
+    layout, this is where you'd interleave."""
+    vp_stage = kwargs.get("vp_stage", None)
+    pp_rank = kwargs.get("pp_rank", None)
+
+    one_layer = xlstm_layer_spec(use_transformer_engine=use_transformer_engine)
+    all_layers = [one_layer] * config.num_layers
+
+    num_layers_to_build = get_num_layers_to_build(
+        config, vp_stage=vp_stage, pp_rank=pp_rank
+    )
+    offset = get_transformer_layer_offset(config, vp_stage=vp_stage, pp_rank=pp_rank)
+    local_layers = all_layers[offset:offset + num_layers_to_build]
+
+    return TransformerBlockSubmodules(
+        layer_specs=local_layers,
+        layer_norm=TENorm if use_transformer_engine else None,
+    )
+
+
+# Monkey-patch the GPT spec resolver. When model_provider() in pretrain_gpt.py
+# calls get_gpt_decoder_block_spec(...), it gets our xLSTM block instead.
+_gpt_specs.get_gpt_decoder_block_spec = _xlstm_block_spec
+
+
+if __name__ == "__main__":
+    # Run pretrain_gpt's main with the patch in place. Use runpy so the
+    # __name__ == "__main__" guard inside pretrain_gpt.py fires.
+    pretrain_gpt_path = os.path.join(
+        os.path.dirname(os.path.abspath(__file__)), "pretrain_gpt.py"
+    )
+    runpy.run_path(pretrain_gpt_path, run_name="__main__")
