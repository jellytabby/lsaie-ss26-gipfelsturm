+# Copyright (c) 2026 Gipfelsturm. xLSTM layer spec for Megatron-LM core_v0.16.1.
+#
+# Install path: megatron/core/models/xlstm/xlstm_layer_specs.py
+#   (mirrors megatron/core/models/mamba/mamba_layer_specs.py)
+#
+# Mirrors megatron/core/models/gpt/gpt_layer_specs.py but swaps SelfAttention
+# for xLSTMMixer. Everything else (input layernorm, BDA, pre-MLP layernorm,
+# MLP, output BDA) stays identical — that's the whole point of the spec
+# system, you only change the mixer.
+
+from megatron.core.fusions.fused_bias_dropout import get_bias_dropout_add
+from megatron.core.ssm.xlstm_mixer import xLSTMMixer, xLSTMMixerSubmodules
+from megatron.core.transformer.identity_op import IdentityOp
+from megatron.core.transformer.mlp import MLP, MLPSubmodules
+from megatron.core.transformer.spec_utils import ModuleSpec
+from megatron.core.transformer.transformer_layer import (
+    TransformerLayer,
+    TransformerLayerSubmodules,
+)
+
+try:
+    # Prefer the TE-backed norms/linears — they're what the GPT spec uses
+    # in fp8/bf16 paths and what launch.sh already exercises.
+    from megatron.core.extensions.transformer_engine import (
+        TEColumnParallelLinear,
+        TELayerNormColumnParallelLinear,
+        TENorm,
+        TERowParallelLinear,
+    )
+    HAVE_TE = True
+except ImportError:
+    HAVE_TE = False
+
+
+def xlstm_layer_spec(use_transformer_engine: bool = True) -> ModuleSpec:
+    """Returns a ModuleSpec describing one xLSTM decoder layer.
+
+    Layer structure (identical to a GPT layer except the mixer):
+
+        x ──► RMSNorm ──► xLSTMMixer ──► (BDA residual) ──┐
+                                                          ├──► RMSNorm ──► MLP ──► (BDA residual) ──► out
+        x ────────────────────────────────────────────────┘
+
+    The same TransformerLayer class wires this up — only the
+    self_attention submodule swaps to xLSTMMixer.
+
+    Args:
+        use_transformer_engine: whether to use TE-backed norms and MLP
+            linears. Default True matches launch.sh's TE setup.
+    """
+    if use_transformer_engine:
+        assert HAVE_TE, "transformer_engine is required for use_transformer_engine=True"
+        layer_norm_cls = TENorm
+        linear_fc1_cls = TELayerNormColumnParallelLinear
+        linear_fc2_cls = TERowParallelLinear
+    else:
+        # Local fallback — useful for debugging without TE.
+        from megatron.core.transformer.torch_norm import WrappedTorchNorm
+        from megatron.core.tensor_parallel.layers import (
+            ColumnParallelLinear,
+            RowParallelLinear,
+        )
+        layer_norm_cls = WrappedTorchNorm
+        linear_fc1_cls = ColumnParallelLinear
+        linear_fc2_cls = RowParallelLinear
+
+    mlp = ModuleSpec(
+        module=MLP,
+        submodules=MLPSubmodules(
+            linear_fc1=linear_fc1_cls,
+            linear_fc2=linear_fc2_cls,
+        ),
+    )
+
+    return ModuleSpec(
+        module=TransformerLayer,
+        submodules=TransformerLayerSubmodules(
+            # When fc1 is a TELayerNormColumnParallelLinear, the norm is
+            # fused INTO it — so pre_mlp_layernorm becomes IdentityOp. We
+            # don't have that fusion for the mixer though, so we need a
+            # real norm in front. Match the local-spec layout: explicit
+            # input_layernorm, IdentityOp for pre_mlp_layernorm when the
+            # fc1 fuses it, else explicit norm.
+            input_layernorm=layer_norm_cls,
+            self_attention=ModuleSpec(
+                module=xLSTMMixer,
+                submodules=xLSTMMixerSubmodules(),
+                # No params dict needed — defaults are fine. attn_mask_type
+                # is accepted but ignored since xLSTM is causal by gates.
+            ),
+            self_attn_bda=get_bias_dropout_add,
+            pre_mlp_layernorm=IdentityOp if use_transformer_engine else layer_norm_cls,
+            mlp=mlp,
+            mlp_bda=get_bias_dropout_add,
+        ),
+    )
