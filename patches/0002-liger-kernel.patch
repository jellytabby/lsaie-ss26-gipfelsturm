+    HAVE_LIGER_RMSNORM = True
+except ImportError:
+    HAVE_LIGER_RMSNORM = False
+
+if __import__('os').environ.get('LOCAL_RANK', '-1') in ('0', '-1'):
+    print(f'[Liger] RMSNorm: {"ACTIVE" if HAVE_LIGER_RMSNORM else "not installed — Megatron fallback"}', flush=True)
+
+class LigerRMSNormWrapper(torch.nn.Module):
+    def __init__(self, hidden_size, eps=1e-5, sequence_parallel=False):
+        super().__init__()
+        self.weight = torch.nn.Parameter(torch.ones(hidden_size))
+        self.eps = eps
+        # Required by Megatron's distributed optimizer to correctly route weight gradients
+        setattr(self.weight, 'sequence_parallel', sequence_parallel)
+
+    def forward(self, x):
+        ori_shape = x.shape
+        x_2d = x.reshape(-1, ori_shape[-1])
+        out = LigerRMSNormFunction.apply(x_2d, self.weight, self.eps)
+        return out.view(ori_shape)
+
 
